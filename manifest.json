{
  "manifest_version": 3,
  "name": "LinkedIn Feed Blocker",
  "version": "1.0.3",
  "description": "Hides LinkedIn's home feed while keeping the rest of LinkedIn available.",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-linkedin-7c2a9d41@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/*",
        "*://linkedin.com/*",
        "*://*.linkedin.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
